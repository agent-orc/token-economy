{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/token-economy/task-class-study.schema.json",
  "title": "Token Economy task-class study",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studyVersion", "taskClass", "status", "scenarios", "variants", "outcome", "qualificationGate", "evidenceInputs", "limitations"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "studyVersion": { "type": "string", "minLength": 1 },
    "taskClass": { "type": "string", "minLength": 1 },
    "status": { "enum": ["protocolReady", "pilotComplete", "qualified"] },
    "scenarios": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model", "thinkingLevel"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "thinkingLevel": { "type": "string", "minLength": 1 }
        }
      }
    },
    "candidateMatrix": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model", "thinkingLevel", "measurementStatus"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "thinkingLevel": { "type": "string", "minLength": 1 },
          "measurementStatus": { "enum": ["measuredPilot", "scheduled"] }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryMetric", "measures", "passRule", "rankingRule"],
      "properties": {
        "primaryMetric": { "type": "string", "minLength": 1 },
        "measures": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "passRule": { "type": "string", "minLength": 1 },
        "rankingRule": { "type": "string", "minLength": 1 }
      }
    },
    "jury": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "thinkingLevel", "blinded", "checklist"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "thinkingLevel": { "type": "string", "minLength": 1 },
        "blinded": { "const": true },
        "checklist": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "qualificationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumAttemptsPerVariant", "minimumScenarioCount", "minimumOutcomeCoverage", "maximumSemanticReissueRate"],
      "properties": {
        "minimumAttemptsPerVariant": { "type": "integer", "minimum": 1 },
        "minimumScenarioCount": { "type": "integer", "minimum": 2 },
        "minimumOutcomeCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumSemanticReissueRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidenceInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "use"],
        "properties": {
          "kind": { "enum": ["controlled", "observational", "protocol"] },
          "reference": { "type": "string", "minLength": 1 },
          "use": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
