{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Token Economy subscription catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOfDate",
    "plans"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "asOfDate": {
      "type": "string",
      "format": "date"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plan"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "name",
        "cliIds",
        "monthlyUsd",
        "billing",
        "modelAccess",
        "limits",
        "sourceIds",
        "termsSourceIds",
        "notes",
        "headlessUse",
        "thirdPartyUse"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "enum": [
            "anthropic",
            "openai",
            "google",
            "github"
          ]
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "cliIds": {
          "$ref": "#/$defs/ids"
        },
        "monthlyUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "billing": {
          "$ref": "#/$defs/id"
        },
        "modelAccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "modelIds"
          ],
          "properties": {
            "mode": {
              "enum": [
                "listed",
                "account",
                "dynamic",
                "automatic"
              ]
            },
            "modelIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/limit"
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "termsSourceIds": {
          "$ref": "#/$defs/ids"
        },
        "notes": {
          "type": "string"
        },
        "headlessUse": {
          "$ref": "#/$defs/useContext"
        },
        "thirdPartyUse": {
          "$ref": "#/$defs/useContext"
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "pool",
        "unit",
        "value",
        "note"
      ],
      "properties": {
        "window": {
          "$ref": "#/$defs/id"
        },
        "pool": {
          "$ref": "#/$defs/id"
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "useContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "documented",
            "conditional",
            "restricted",
            "ambiguous",
            "unknown"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
