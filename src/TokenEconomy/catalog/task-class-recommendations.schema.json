{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/token-economy/task-class-recommendations.schema.json",
  "title": "Token Economy task-class recommendations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taxonomyVersion",
    "rationaleVersion",
    "evidenceAsOfDate",
    "recommendations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taxonomyVersion": {
      "type": "string",
      "minLength": 1
    },
    "rationaleVersion": {
      "type": "string",
      "minLength": 1
    },
    "evidenceAsOfDate": {
      "type": "string",
      "format": "date"
    },
    "recommendations": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskClass",
          "id",
          "label",
          "family",
          "definition",
          "outcomeMeasure",
          "benchmarkStatus",
          "status",
          "recommended",
          "downgradeWhen",
          "neverDowngradeWhen",
          "rationale",
          "rationaleVersion",
          "evidenceVersion",
          "scenarioCount",
          "attemptCount",
          "outcomeRate",
          "costPerSuccessfulOutcome",
          "evidence"
        ],
        "properties": {
          "taskClass": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "coding",
              "implementation",
              "review",
              "judgment"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "outcomeMeasure": {
            "type": "string",
            "minLength": 1
          },
          "benchmarkStatus": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "controlledPilot",
              "controlledCodingEvidence",
              "policyBaseline"
            ]
          },
          "recommended": {
            "$ref": "#/$defs/route"
          },
          "equivalentRoutes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/route"
            },
            "uniqueItems": true
          },
          "downgrade": {
            "oneOf": [
              {
                "$ref": "#/$defs/route"
              },
              {
                "type": "null"
              }
            ]
          },
          "downgradeWhen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "neverDowngradeWhen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "rationaleVersion": {
            "type": "string",
            "minLength": 1
          },
          "evidenceVersion": {
            "type": "string",
            "minLength": 1
          },
          "scenarioCount": {
            "type": "integer",
            "minimum": 0
          },
          "attemptCount": {
            "type": "integer",
            "minimum": 0
          },
          "outcomeRate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "costPerSuccessfulOutcome": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "amountUsd",
                  "pricedAtUtc",
                  "includesVerification",
                  "note"
                ],
                "properties": {
                  "amountUsd": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "pricedAtUtc": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "includesVerification": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidenceKind",
                "reference",
                "summary"
              ],
              "properties": {
                "evidenceKind": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "gpt6Candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/route"
            }
          },
          "legacyFallbacks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/route"
            }
          },
          "historicalBaseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recommended",
              "status",
              "benchmarkStatus",
              "rationale",
              "evidenceVersion",
              "scenarioCount",
              "attemptCount",
              "outcomeRate",
              "costPerSuccessfulOutcome",
              "evidence"
            ],
            "properties": {
              "recommended": {
                "$ref": "#/$defs/route"
              },
              "status": {
                "enum": [
                  "controlledPilot",
                  "controlledCodingEvidence",
                  "policyBaseline"
                ]
              },
              "benchmarkStatus": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "evidenceVersion": {
                "type": "string",
                "minLength": 1
              },
              "scenarioCount": {
                "type": "integer",
                "minimum": 0
              },
              "attemptCount": {
                "type": "integer",
                "minimum": 0
              },
              "outcomeRate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "costPerSuccessfulOutcome": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "amountUsd",
                      "pricedAtUtc",
                      "includesVerification",
                      "note"
                    ],
                    "properties": {
                      "amountUsd": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "pricedAtUtc": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "includesVerification": {
                        "type": "boolean"
                      },
                      "note": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidenceKind",
                    "reference",
                    "summary"
                  ],
                  "properties": {
                    "evidenceKind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "languagePriors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "textKind": {
            "enum": [
              "copy",
              "documentation",
              "operatorMessages",
              "replies"
            ]
          },
          "taskClass": {
            "const": "docEdit"
          },
          "language": {
            "enum": [
              "de",
              "en"
            ]
          },
          "asOfDate": {
            "type": "string",
            "format": "date"
          },
          "requirement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "language": {
                "enum": [
                  "de",
                  "en"
                ]
              },
              "minimumOverall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minimumScores": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "readability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "warmth": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "directness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "absenceOfAiIsms": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "toneAdherence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "factualRestraint": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": []
              },
              "thinkingLevel": {
                "enum": [
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "ultra",
                  "max"
                ]
              },
              "allowProvisional": {
                "type": "boolean"
              }
            },
            "required": [
              "language",
              "minimumOverall",
              "minimumScores",
              "thinkingLevel",
              "allowProvisional"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "modelId": {
                  "enum": [
                    "gpt-6-astra",
                    "gpt-6-sol",
                    "gpt-6-luna",
                    "gpt-5.6-sol",
                    "gpt-5.6-terra",
                    "gpt-5.6-luna",
                    "claude-opus-5-5",
                    "claude-opus-5",
                    "claude-sonnet-5",
                    "claude-haiku-4-5",
                    "claude-fable-5-1"
                  ]
                },
                "thinkingLevel": {
                  "enum": [
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "ultra",
                    "max"
                  ]
                },
                "evidenceStatus": {
                  "enum": [
                    "provisional",
                    "observed"
                  ]
                },
                "recordId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "costPerSampleUsd": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "modelId",
                "thinkingLevel",
                "evidenceStatus",
                "recordId",
                "costPerSampleUsd"
              ]
            },
            "minItems": 0
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "textKind",
          "taskClass",
          "language",
          "asOfDate",
          "requirement",
          "candidates",
          "note"
        ]
      },
      "minItems": 8
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "model",
        "thinkingLevel"
      ],
      "properties": {
        "routeId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "thinkingLevel": {
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xHigh",
            "ultra",
            "max"
          ]
        }
      }
    }
  }
}
