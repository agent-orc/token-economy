{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dated operator and vendor subscription evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOfDate",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "asOfDate": {
      "type": "string",
      "format": "date"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "planId",
        "kind",
        "observedFromUtc",
        "observedToUtc",
        "method",
        "cliId",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "planId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "model-probe",
            "quota-reset",
            "burn-rate",
            "window-ratio",
            "credit-rate-card",
            "message-range",
            "vendor-statement"
          ]
        },
        "observedFromUtc": {
          "type": "string",
          "format": "date-time"
        },
        "observedToUtc": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "cliId": {
          "type": "string",
          "minLength": 1
        },
        "allowedModelIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejectedModelIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "window": {
          "type": "string"
        },
        "resetAtUtc": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date-time"
          }
        },
        "percentagePointsPerHour": {
          "type": "number",
          "minimum": 0
        },
        "percentagePoints": {
          "type": "number",
          "minimum": 0
        },
        "correspondingWeeklyPercentagePoints": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        },
        "evidenceClass": {
          "enum": [
            "M",
            "V",
            "L",
            "P"
          ]
        },
        "inputCreditsPerMTok": {
          "type": "number",
          "minimum": 0
        },
        "cacheReadCreditsPerMTok": {
          "type": "number",
          "minimum": 0
        },
        "outputCreditsPerMTok": {
          "type": "number",
          "minimum": 0
        },
        "minimumMessages": {
          "type": "integer",
          "minimum": 0
        },
        "maximumMessages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "credit-rate-card",
                  "message-range",
                  "vendor-statement"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sourceUrl",
              "retrievedAt",
              "evidenceClass"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "credit-rate-card"
              }
            }
          },
          "then": {
            "required": [
              "modelId",
              "inputCreditsPerMTok",
              "cacheReadCreditsPerMTok",
              "outputCreditsPerMTok"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "message-range"
              }
            }
          },
          "then": {
            "required": [
              "modelId",
              "window",
              "minimumMessages",
              "maximumMessages"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "vendor-statement"
              }
            }
          },
          "then": {
            "required": [
              "quote"
            ]
          }
        }
      ]
    }
  }
}
