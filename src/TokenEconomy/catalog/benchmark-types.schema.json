{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/token-economy/benchmark-types.schema.json",
  "title": "Token Economy benchmark type catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "records"],
  "properties": {
    "$schema": { "const": "benchmark-types.schema.json" },
    "schemaVersion": { "const": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/benchmarkType" }
    }
  },
  "$defs": {
    "benchmarkType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "name", "publisher", "capabilityClass", "unit",
        "minimumScore", "maximumScore", "direction", "methodologyUrl",
        "citationNote", "validFrom", "capturedAt", "retrievedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "capabilityClass": { "enum": ["codingAgent", "reasoning", "instructionFollowing", "longContext", "controlledSetup"] },
        "unit": { "type": "string", "minLength": 1 },
        "minimumScore": { "type": "number" },
        "maximumScore": { "type": "number" },
        "direction": { "enum": ["higherIsBetter", "lowerIsBetter"] },
        "methodologyUrl": { "type": "string", "format": "uri" },
        "citationNote": { "type": "string", "minLength": 1 },
        "validFrom": { "type": "string", "format": "date" },
        "capturedAt": { "type": "string", "format": "date" },
        "retrievedAt": { "type": "string", "format": "date" }
      }
    }
  }
}
