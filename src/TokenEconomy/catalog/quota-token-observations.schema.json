{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tokens per quota percentage point observations",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "observations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "tokenCount": {"type": ["integer", "null"], "minimum": 0},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider", "planId", "cliId", "window", "period", "percentagePoints", "totalTokensApprox", "uncachedInputTokensApprox", "cachedInputTokensApprox", "outputTokensApprox", "reasoningTokensApprox", "outputIncludesReasoning", "method", "completeness", "note"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1},
        "planId": {"type": "string", "minLength": 1}, "cliId": {"type": "string", "minLength": 1},
        "window": {"type": "string", "minLength": 1}, "period": {"type": "string", "minLength": 1},
        "percentagePoints": {"type": "number", "exclusiveMinimum": 0},
        "totalTokensApprox": {"$ref": "#/$defs/tokenCount"},
        "uncachedInputTokensApprox": {"$ref": "#/$defs/tokenCount"},
        "cachedInputTokensApprox": {"$ref": "#/$defs/tokenCount"},
        "outputTokensApprox": {"$ref": "#/$defs/tokenCount"},
        "reasoningTokensApprox": {"$ref": "#/$defs/tokenCount"},
        "outputIncludesReasoning": {"type": "boolean"},
        "method": {"type": "string", "minLength": 1},
        "completeness": {"enum": ["complete", "approximate", "incomplete"]},
        "note": {"type": "string"}
      }
    }
  }
}
